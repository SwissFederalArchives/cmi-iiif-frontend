{
  "name": "@archival-iiif/viewer-react",
  "version": "2.0.7",
  "license": "MIT",
  "homepage": ".",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "@blueprintjs/core": "^4.10.2",
    "@blueprintjs/icons": "^4.6.0",
    "@emotion/react": "^11.10.4",
    "@emotion/styled": "^11.10.4",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.0",
    "@iiif/vocabulary": "^1.0.22",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/system": "^7.0.0",
    "chardet": "^2.0.0",
    "core-js": "^3.21.1",
    "dompurify": "^3.4.3",
    "i18next": "^23.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^4.0.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "manifesto.js": "^4.2.14",
    "mirador": "^4.0.0",
    "react": "^18.2.0",
    "react-app-polyfill": "^3.0.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.0",
    "react-router": "^7.6.2",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@types/react": "18.2.52",
    "@types/react-dom": "18.2.18",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cpy-cli": "^7.0.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.0.0",
    "dotenv-webpack": "^9.0.0",
    "html-webpack-plugin": "^5.5.0",
    "patch-package": "^8.0.1",
    "shx": "^0.4.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.3.1",
    "typescript": "5.9.3",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^6.0.0"
  },
  "scripts": {
    "dev": "yarn start",
    "remove_locales": "shx rm -rf ./public/vendor/current/locales/",
    "remove_icons": "shx rm -rf ./public/vendor/current/img/ico/",
    "remove_js": "shx rm -rf ./public/vendor/current/js/",
    "remove_fonts": "shx rm -rf ./public/vendor/current/fonts/",
    "remove_style": "shx rm -rf ./public/vendor/current/css/",
    "copy_eth_locales": "shx cp -r ./public/vendor/eth/locales/ ./public/vendor/current/",
    "copy_eth_style": "shx cp -r ./public/vendor/eth/css/ ./public/vendor/current/css/",
    "copy_eth_icons": "shx cp -r ./public/vendor/eth/img/ico/ ./public/vendor/current/img/",
    "copy_eth_logo": "shx cp ./public/vendor/eth/img/logo.svg ./src/images/logo.svg",
    "copy_eth_env": "shx cp ./public/vendor/eth/.env ./.env",
    "copy_eth_js": "shx cp -r ./public/vendor/eth/js/ ./public/vendor/current/",
    "copy_federation_locales": "shx cp -r ./public/vendor/federation/locales/ ./public/vendor/current/",
    "copy_federation_style": "shx cp -r ./public/vendor/federation/css/ ./public/vendor/current/css/",
    "copy_federation_icons": "shx cp -r ./public/vendor/federation/img/ico/ ./public/vendor/current/img/",
    "copy_federation_logo": "shx cp ./public/vendor/federation/img/logo.svg ./src/images/logo.svg",
    "copy_federation_env": "shx cp ./public/vendor/federation/.env ./.env",
    "copy_federation_js": "shx cp -r ./public/vendor/federation/js/ ./public/vendor/current/",
    "copy_federation_fonts": "shx cp -r ./public/vendor/federation/fonts/ ./public/vendor/current/",
    "start": "webpack-dev-server --open --env development --mode development --hot",
    "build": "webpack --env --mode production",
    "build:generic": "webpack --env cmd='build:generic' --mode production",
    "build:react": "shx rm -rf ./dist && tsc -p tsconfig.prod.json && cpy \"**/*.{png,css,json}\" ../dist --cwd=src --base=cwd",
    "build:dist": "webpack --mode production && node dist-pkg/buildDistPkg.js",
    "postinstall": "patch-package"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "IE 11"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archival-IIIF/viewer.git"
  },
  "keywords": [
    "IIIF"
  ],
  "author": "Archival IIIF",
  "bugs": {
    "url": "https://github.com/archival-IIIF/viewer/issues"
  }
}
